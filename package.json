{
  "name": "venice-video-mcp",
  "version": "0.5.0",
  "description": "Token-lean MCP server that wraps the Venice Video Harness CLI (v2.3.x with automatic Seedance R2V \u2192 Wan 2.7 keyframes, no-overlap audio scheduling, and continuity rules). 6 verb tools + companion skills for consistency-first AI video creation.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "venice-video-mcp": "./bin/venice-video-mcp.js",
    "venice-video-mcp-install-skills": "./bin/install-skills.js",
    "venice-video-mcp-update": "./bin/venice-video-mcp-update.js"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "examples",
    "scripts/install-skills.js",
    "scripts/update.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "tsx --test test/**/*.test.ts",
    "test:watch": "tsx --test --watch test/**/*.test.ts",
    "install-skills": "node scripts/install-skills.js",
    "update": "node scripts/update.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "venice",
    "venice-ai",
    "ai-video",
    "video-generation",
    "claude-code",
    "cursor",
    "agent",
    "kling",
    "veo",
    "sora",
    "wan",
    "seedance"
  ],
  "homepage": "https://github.com/jordanurbs/venice-video-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordanurbs/venice-video-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jordanurbs/venice-video-mcp/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
